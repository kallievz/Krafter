@using AditiKraft.Krafter.UI.Web.Client.Common.Components.Brand
@using AditiKraft.Krafter.UI.Web.Client.Common.Models
@inherits LayoutComponentBase
<RadzenLayout Style="grid-template-columns: auto 1fr auto; grid-template-rows: auto 1fr auto; grid-template-areas: 'rz-header rz-header rz-header' 'rz-sidebar rz-body rz-config-sidebar' 'rz-footer rz-footer rz-footer'">
    <RadzenHeader>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" JustifyContent="JustifyContent.Left">
                    <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)"/>
                    <span class="header-desktop-only">
                        <Logo Orientation="LogoOrientation.Horizontal" Size="LogoSize.ExtraSmall"/>
                    </span>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" JustifyContent="JustifyContent.Center">
                    <RadzenLabel>
                        <strong> @LocalAppState.CurrentPageTitle</strong>
                    </RadzenLabel>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" JustifyContent="JustifyContent.Right">
                    <RadzenDropDown TValue="string" Data="@_availableLanguages" TextProperty="Name" ValueProperty="Code"
                                    Value="@_selectedLanguageCode" Change="@ChangeLanguageAsync" Style="width: 130px; margin-right: 0.5rem;" />
                    <span class="header-desktop-only">
                        <TopRight></TopRight>
                    </span>
                    <Notifications></Notifications>
                    <RadzenSidebarToggle Icon="settings" Click="@(() => _configSidebarExpanded = !_configSidebarExpanded)" class="rz-m-0"/>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>

    <RadzenBody>
        <ChildContent>
            <PageTitle>@LocalAppState.CurrentPageTitle</PageTitle>
            @Body
        </ChildContent>
    </RadzenBody>
    <RadzenSidebar @bind-Expanded="@_sidebarExpanded" class="demos-sidebar" style="display: flex; flex-direction: column">
        <AuthorizeView>
            <Authorized>
                <div style="padding: 0.5rem">
                    <RadzenTextBox id="find" Placeholder="@L.Localize("UI_Find", "Find items ...")" type="search" @oninput="@FilterPanelMenu" style="width: 100%" Class="rz-search-input" aria-label="find"/>
                </div>
                <div style="flex: 1; overflow: auto">
                    <RadzenPanelMenu>
                        @foreach (var category in _menus)
                        {
                            if (category.Children != null && category.Children.Count() > 0 && (HasChildPermission(category)))
                            {
                                <NavigationItem @key=category @bind-Expanded=@category.Expanded Example=@category>


                                    @if (category.Children != null && category.Children.Count() > 0)
                                    {
                                        @foreach (var menu in category.Children)
                                        {
                                            if (menu.Children != null && menu.Children.Count() > 0 && HasChildPermission(menu))
                                            {
                                                <NavigationItem @key=menu @bind-Expanded=@menu.Expanded Example=@menu>
                                                    @foreach (var child in menu.Children)
                                                    {
                                                        if (HasPermission(menu))
                                                        {
                                                            <NavigationItem @key=child @bind-Expanded=@child.Expanded Example=@child/>
                                                        }
                                                    }
                                                </NavigationItem>
                                            }
                                            else if (HasPermission(menu))
                                            {
                                                <NavigationItem @key=menu @bind-Expanded=@menu.Expanded Example=@menu/>
                                            }
                                        }
                                    }

                                </NavigationItem>
                            }
                            else if (HasPermission(category))
                            {
                                <NavigationItem @key=category @bind-Expanded=@category.Expanded Example=@category>

                                </NavigationItem>
                            }
                        }
                    </RadzenPanelMenu>
                </div>
            </Authorized>
        </AuthorizeView>
    </RadzenSidebar>
    <RadzenSidebar Responsive="false" @bind-Expanded="@_configSidebarExpanded" class="rz-sidebar-second" Style="@($"--rz-sidebar-width: {(IsMobileDevice ? "100vw" : "300px")}; grid-area: rz-config-sidebar; background-color: var(--rz-body-background-color); color: var(--rz-text-color);")">
        <RadzenStack class="rz-p-3" Gap="0">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">@L.Localize("UI_Common_ConfigTitle", "Demos Configuration")</RadzenText>
                <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(() => _configSidebarExpanded = false)" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" class="rz-mt-3">
                <TopRight ShowProfileCard="true" OnNavigating="@(() => _configSidebarExpanded = false)"></TopRight>
            </RadzenStack>


@*             <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" class="rz-mt-3">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenLabel Text="@L.Localize("UI_Appearance_WCAGLabel", "Use WCAG compliant colors")" Component="WCAG" Title="@L.Localize("UI_Appearance_WCAGInfo", "Use WCAG 2.2 AA compliant color swatches")"/>
                    <RadzenButton Icon="info" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" @ref="_wcagColorsInfo" Click="@(args => WcagColorsTooltip(_wcagColorsInfo.Element, new TooltipOptions() { Position = TooltipPosition.Left, Duration = null, Style = "background: var(--rz-base-900); color: var(--rz-base-100)" }))"/>
                </RadzenStack>
                <RadzenSwitch Value="@(themeService.Wcag == true)" Name="WCAG" Change="@(themeService.SetWcag)"/>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" class="rz-mt-3">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenLabel Text="@L.Localize("UI_Appearance_RTLLabel", "Enable RTL directionality")" Component="RTL" Title="@L.Localize("UI_Appearance_RTLInfo", "Use right to left direction for languages that are written from the right to the left (like Arabic)")"/>
                    <RadzenButton Icon="info" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" @ref="_rtlInfo" Click="@(args => RtlTooltip(_rtlInfo.Element, new TooltipOptions() { Position = TooltipPosition.Left, Duration = null, Style = "background: var(--rz-base-900); color: var(--rz-base-100)" }))"/>
                </RadzenStack>
                <RadzenSwitch Value="@(themeService.RightToLeft == true)" Name="RTL" Change="@(themeService.SetRightToLeft)"/>
            </RadzenStack>
            *@


            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" class="rz-mt-3">
                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" class="rz-m-0">@L.Localize("UI_ThemePreference", "Theme Preference")</RadzenText>
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Start" Gap="0.25rem" class="rz-mt-2">
                <RadzenRadioButtonList @bind-Value="themePreference" TValue="ThemeManager.ThemePreference">
                    <Items>
                        <RadzenRadioButtonListItem Text="@L.Localize("UI_ThemeAuto", "Auto (System)")" Value="ThemeManager.ThemePreference.Auto"/>
                        <RadzenRadioButtonListItem Text="@L.Localize("UI_ThemeLight", "Light")" Value="ThemeManager.ThemePreference.Light"/>
                        <RadzenRadioButtonListItem Text="@L.Localize("UI_ThemeDark", "Dark")" Value="ThemeManager.ThemePreference.Dark"/>
                    </Items>
                </RadzenRadioButtonList>
            </RadzenStack>


        </RadzenStack>
    </RadzenSidebar>

    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" class="rz-px-4">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">Aditi Kraft© @DateTime.UtcNow.Year</RadzenText>
        </RadzenStack>
    </RadzenFooter>

</RadzenLayout>


@if (!_rendered)
{
    <div class="rz-app-loading">
        <div class="logo-loading"></div>
    </div>
}

@code {

    private ThemeManager.ThemePreference themePreference
    {
        get => themeManager.CurrentPreference;
        set { themeManager.SetThemePreferenceAsync(value).ConfigureAwait(false); }
    }


}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
