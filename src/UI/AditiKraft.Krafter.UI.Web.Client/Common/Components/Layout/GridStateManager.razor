@using AditiKraft.Krafter.Contracts.Contracts.Grids
@using AditiKraft.Krafter.UI.Web.Client.Features.GridStates

<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap"
             Class="grid-state-manager-toolbar"
             Style="position: relative; overflow: visible; isolation: isolate;">
    <RadzenDropDown TValue="string"
                    Data="@_states"
                    ValueProperty="Id"
                    TextProperty="Name"
                    @bind-Value="_selectedStateId"
                    Placeholder="Saved states"
                    Change="@OnSelectionChangedAsync"
                    Style="min-width: 220px;"
                    Disabled="@Disabled" />

    <RadzenTextBox @bind-Value="_stateName" Placeholder="State name" Style="min-width: 180px;" Disabled="@Disabled" />

    <RadzenCheckBox @bind-Value="_isDefault" Name="gridStateDefault" Disabled="@Disabled" />
    <RadzenLabel Text="Default" Component="gridStateDefault" />

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap"
                 Class="grid-state-actions" Style="position: relative;">
        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="save" Text="Save"
                      Click="@SaveStateAsync" Disabled="@(Disabled || _isBusy)" />
        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="edit" Text="Update"
                      Click="@UpdateStateAsync" Disabled="@(Disabled || _isBusy || string.IsNullOrWhiteSpace(_selectedStateId))" />
        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Icon="delete" Text="Delete"
                      Click="@DeleteStateAsync" Disabled="@(Disabled || _isBusy || string.IsNullOrWhiteSpace(_selectedStateId))" />
        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="refresh" Text="Refresh"
                      Click="@LoadStatesAsync" Disabled="@(Disabled || _isBusy)" />
    </RadzenStack>
</RadzenStack>
