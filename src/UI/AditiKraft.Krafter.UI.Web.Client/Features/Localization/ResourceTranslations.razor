@using AditiKraft.Krafter.Contracts.Common
@using AditiKraft.Krafter.Contracts.Common.Auth.Permissions
@using AditiKraft.Krafter.Contracts.Contracts.Localization
@using AditiKraft.Krafter.UI.Web.Client.Common.Permissions
@attribute [Route(RoutePath)]
@attribute [MustHavePermission(PermissionAction.View, PermissionResource.LocalizationResourceTranslations)]

<LocalizationNavigation />

<AdvancedDataGrid TItem="ResourceTranslationDto"
                  Data="@_response?.Data"
                  Count="@(_response?.Data?.Count ?? 0)"
                  IsLoading="@_isLoading"
                  ExportFileBaseName="resource-translations"
                  ExportTitle="Resource Translations"
                  ComponentKey="@RoutePath">
    <ToolbarActions>
        <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Create, PermissionResource.LocalizationResourceTranslations))">
            <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Icon="add_circle_outline" Text="@L.Localize("Button_AddResourceTranslation", "Add Resource Translation")" Click="@AddResourceTranslationAsync" />
        </AuthorizeView>
    </ToolbarActions>
    <Columns>
        <RadzenDataGridColumn TItem="ResourceTranslationDto" Property="Resource.Key" Title="@L.Localize("ResourceTranslation_Resource", "Resource")">
            <Template Context="data">
                @data.Resource?.Key
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ResourceTranslationDto" Property="Language.Code" Title="@L.Localize("ResourceTranslation_Language", "Language")">
            <Template Context="data">
                @data.Language?.Code (@data.Language?.Name)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ResourceTranslationDto" Property="Value" Title="@L.Localize("ResourceTranslation_Value", "Value")" />
        <RadzenDataGridColumn TItem="ResourceTranslationDto" Property="CreatedOn" Title="@L.Localize("ResourceTranslation_CreatedOn", "Created On")" />
        <RadzenDataGridColumn TItem="ResourceTranslationDto" Property="UpdatedOn" Title="@L.Localize("ResourceTranslation_UpdatedOn", "Updated On")" />
        <RadzenDataGridColumn TItem="ResourceTranslationDto" Title="@L.Localize("DataGrid_Actions", "Actions")" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="9.28vw" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="data">
                <RadzenSplitButton ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Variant="Variant.Flat" AlwaysOpenPopup="true" Click="@(args => ActionClickedAsync(args, data))" Text="@L.Localize("DataGrid_Actions", "Actions")" Icon="settings_applications" Style="margin-right: 4px">
                    <ChildContent>
                        <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Update, PermissionResource.LocalizationResourceTranslations))">
                            <RadzenSplitButtonItem Text="@L.Localize("Button_Edit", "Edit")" Value="@PermissionAction.Update" Icon="edit" />
                        </AuthorizeView>
                        <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Delete, PermissionResource.LocalizationResourceTranslations))">
                            <RadzenSplitButtonItem Text="@L.Localize("Button_Delete", "Delete")" Value="@PermissionAction.Delete" Icon="delete" />
                        </AuthorizeView>
                    </ChildContent>
                </RadzenSplitButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</AdvancedDataGrid>
