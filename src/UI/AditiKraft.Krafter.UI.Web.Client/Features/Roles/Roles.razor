@using AditiKraft.Krafter.UI.Web.Client.Common.Models
@using AditiKraft.Krafter.UI.Web.Client.Common.Permissions
@attribute [Route(RoutePath)]
@attribute [MustHavePermission(PermissionAction.View, PermissionResource.Roles)]

<AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Create, PermissionResource.Roles))">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" JustifyContent="JustifyContent.End" class="mt-1 mb-2">
        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Icon="add_circle_outline" Text="Role" Click="@AddRoleAsync"/>
    </RadzenStack>
</AuthorizeView>

<RadzenDataGrid Responsive="true" ShowCellDataAsTooltip="LocalAppState.ShowCellDataAsTooltip" Density="LocalAppState.Density" AllowColumnResize="LocalAppState.AllowColumnResize" IsLoading="@_isLoading" Count="@(_response?.Data?.TotalCount ?? 0)" LoadData="@LoadDataAsync" AllowSorting="true" Data="@_response?.Data?.Items" AllowFiltering="true" AllowPaging="true" PageSize="@_requestInput.MaxResultCount" PagerHorizontalAlign="HorizontalAlign.Center">
    <Columns>

        <RadzenDataGridColumn Property="Name" Title="Name"/>
        <RadzenDataGridColumn Property="Description" Title="Description"/>
        <RadzenDataGridColumn Property="CreatedById" Title="UserId">
            <Template Context="data">
                @data.CreatedById
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Actions" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="9.28vw" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="data">
                @if (RoleConstants.IsDefault(data.Name!) == false)
                {
                    <RadzenSplitButton ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Variant="Variant.Flat" AlwaysOpenPopup="true" Click="@(args => ActionClickedAsync(args, data))" Text="Actions" Icon="settings_applications" Style="margin-right: 4px">
                        <ChildContent>
                            <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Update, PermissionResource.Roles))">
                                <RadzenSplitButtonItem Text="Edit" Value="@PermissionAction.Update" Icon="edit"/>
                            </AuthorizeView>

                            <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Delete, PermissionResource.Roles))">
                                <RadzenSplitButtonItem Text="Delete" Value="@PermissionAction.Delete" Icon="delete"/>
                            </AuthorizeView>
                        </ChildContent>
                    </RadzenSplitButton>
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
