@using AditiKraft.Krafter.UI.Web.Client.Common.Models
@using AditiKraft.Krafter.UI.Web.Client.Common.Permissions
@attribute [Route(RoutePath)]
@attribute [MustHavePermission(PermissionAction.View, PermissionResource.Roles)]

<AdvancedDataGrid TItem="RoleDto"
                  Data="@_response?.Data?.Items"
                  Count="@(_response?.Data?.TotalCount ?? 0)"
                  IsLoading="@_isLoading"
                  LoadData="@LoadDataAsync"
                  ExportFileBaseName="roles"
                  ExportTitle="Roles"
                  ComponentKey="@RoutePath">
    <ToolbarActions>
        <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Create, PermissionResource.Roles))">
            <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Icon="add_circle_outline" Text="@L.Localize("Button_AddRole", "Add Role")" Click="@AddRoleAsync" />
        </AuthorizeView>
    </ToolbarActions>
    <Columns>
        <RadzenDataGridColumn TItem="RoleDto" Property="Name" Title="@L.Localize("ApplicationRole_Name", "Name")" /> 
        <RadzenDataGridColumn TItem="RoleDto" Property="Description" Title="@L.Localize("ApplicationRole_Description", "Description")" />
        <RadzenDataGridColumn TItem="RoleDto" Property="CreatedById" Title="@L.Localize("ApplicationRole_CreatedById", "UserId")">
            <Template Context="data">
                @data.CreatedById
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RoleDto" Title="@L.Localize("DataGrid_Actions", "Actions")" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="9.28vw" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="data">
                @if (!RoleConstants.IsDefault(data.Name!))
                {
                    <RadzenSplitButton ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Variant="Variant.Flat" AlwaysOpenPopup="true" Click="@(args => ActionClickedAsync(args, data))" Text="@L.Localize("DataGrid_Actions", "Actions")" Icon="settings_applications" Style="margin-right: 4px">
                        <ChildContent>
                            <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Update, PermissionResource.Roles))">
                                <RadzenSplitButtonItem Text="@L.Localize("Button_Edit", "Edit")" Value="@PermissionAction.Update" Icon="edit" />
                            </AuthorizeView>

                            <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Delete, PermissionResource.Roles))">
                                <RadzenSplitButtonItem Text="@L.Localize("Button_Delete", "Delete")" Value="@PermissionAction.Delete" Icon="delete" />
                            </AuthorizeView>
                        </ChildContent>
                    </RadzenSplitButton>
                }
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</AdvancedDataGrid>
