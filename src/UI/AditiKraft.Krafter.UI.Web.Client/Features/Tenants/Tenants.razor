@using AditiKraft.Krafter.UI.Web.Client.Common.Models
@using AditiKraft.Krafter.UI.Web.Client.Common.Permissions
@attribute [Route(RoutePath)]
@attribute [MustHavePermission(PermissionAction.View, PermissionResource.Tenants)]


<AdvancedDataGrid TItem="TenantDto"
                  Data="@_response?.Data?.Items"
                  Count="@(_response?.Data?.TotalCount ?? 0)"
                  IsLoading="@_isLoading"
                  LoadData="@LoadDataAsync"
                  ExportFileBaseName="tenants"
                  ExportTitle="Tenants"
                  ComponentKey="@RoutePath">
    <ToolbarActions>
        <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Create, PermissionResource.Tenants))">
            <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Icon="add_circle_outline" Text="@L.Localize("Button_AddTenant", "Add Tenant")"
                          Click="@AddTenantAsync" />
        </AuthorizeView>
    </ToolbarActions>
    <Columns>
        <RadzenDataGridColumn TItem="TenantDto" Property="Identifier" Title="@L.Localize("Tenant_Identifier", "Identifier")">  
            <Template Context="data">
                @if (urls.CanUseTenantIdentifier(data.Identifier))
                {
                    <RadzenLink Path="@urls.GetTenantUiUri(data.Identifier).AbsoluteUri" Text="@data.Identifier" target="_blank" />
                }
                else
                {
                    @data.Identifier
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="TenantDto" Property="Name" Title="@L.Localize("Tenant_Name", "Name")" />
        <RadzenDataGridColumn TItem="TenantDto" Property="AdminEmail" Title="@L.Localize("Tenant_AdminEmail", "Admin Email")" />
        <RadzenDataGridColumn TItem="TenantDto" Property="ValidUpto" Title="@L.Localize("Tenant_Expires", "Expires?")" Filterable="false">
            <Template Context="data">
                @if (data.ValidUpto == DateTime.MaxValue)
                {
                    <span>@L.Localize("Tenant_NoExpiry", "No Expiry")</span>
                }
                else if (RendererInfo.IsInteractive)
                {
                    @data.ValidUpto.ToString(LocalAppState.DateTimeFormat)
                }
                else
                {
                    <span>…</span>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="TenantDto" Property="IsActive" Title="@L.Localize("Tenant_IsActive", "IsActive?")" />

        <RadzenDataGridColumn TItem="TenantDto" Title="@L.Localize("Tenant_CreatedBy", "Created By")" Frozen="true" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
            <Template Context="data">
                @if (data.CreatedBy is not null)
                {
                    @(data.CreatedBy.FirstName + " " + @data.CreatedBy.LastName)
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="TenantDto" Title="@L.Localize("DataGrid_Actions", "Actions")" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" Width="9.28vw" FrozenPosition="FrozenColumnPosition.Right">
            <Template Context="data">
                <RadzenSplitButton ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Variant="Variant.Flat"
                                   AlwaysOpenPopup="true" Click="@(args => ActionClickedAsync(args, data))" Text="@L.Localize("DataGrid_Actions", "Actions")"
                                   Icon="settings_applications" Style="margin-right: 4px">
                    <ChildContent>
                        <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Update, PermissionResource.Tenants))">
                            <RadzenSplitButtonItem Text="@L.Localize("Button_Edit", "Edit")" Value="@PermissionAction.Update" Icon="edit" />
                            <RadzenSplitButtonItem Text="@L.Localize("Button_Settings", "Settings")" Value="settings" Icon="tune" />
                            <RadzenSplitButtonItem Text="@L.Localize("Button_SettingsPage", "Settings Page")" Value="settings-page" Icon="open_in_new" />
                        </AuthorizeView>
                        <AuthorizeView Policy="@(PermissionDefinition.NameFor(PermissionAction.Delete, PermissionResource.Tenants))">
                            <RadzenSplitButtonItem Text="@L.Localize("Button_Delete", "Delete")" Value="@PermissionAction.Delete" Icon="delete" />
                        </AuthorizeView>
                    </ChildContent>
                </RadzenSplitButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</AdvancedDataGrid>
