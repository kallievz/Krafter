@using AditiKraft.Krafter.Contracts.Contracts.Integrations
@using AditiKraft.Krafter.UI.Web.Client.Common.Models
@using AditiKraft.Krafter.UI.Web.Client.Common.Permissions
@attribute [Route(RoutePath)]
@attribute [MustHavePermission(PermissionAction.View, PermissionResource.Tenants)]

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" class="rz-mb-2">
        @_errorMessage
    </RadzenAlert>
}

<AdvancedDataGrid TItem="MunsoftInstanceDto"
                  Data="@_response?.Data?.Items"
                  Count="@(_response?.Data?.TotalCount ?? 0)"
                  IsLoading="@_isLoading"
                  LoadData="@LoadDataAsync"
                  Density="LocalAppState.Density"
                  ShowCellDataAsTooltip="LocalAppState.ShowCellDataAsTooltip"
                  AllowColumnResize="LocalAppState.AllowColumnResize"
                  FilterMode="FilterMode.CheckBoxList"
                  GroupPanelText="@L.Localize("DataGrid_GroupPanelText", "Drag a column header here and drop it to group by that column")"
                  ExportFileBaseName="munsoft-instances"
                  ExportTitle="Munsoft instances"
                  ComponentKey="@RoutePath"
                  PageSizeOptions="new[] { 10, 20, 50, 100, 500 }"
                  PageNumbersCount="7"
                  PagerAlwaysVisible="true"
                  PagingSummaryFormat="@L.Localize("Pager_PagingSummaryFormat", "Page {0} of {1} ({2} items)")"
                  OnFilterCleared="@OnGridFilterClearedAsync"
                  OnGridReset="@OnGridResetAsync">
    <ToolbarActions>
        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Icon="sync" Text="@L.Localize("Button_Sync", "Syncronize")"
                      Click="@SyncAsync" Disabled="@_isLoading" />
    </ToolbarActions>
    <Columns>
        <RadzenDataGridColumn TItem="MunsoftInstanceDto" Property="Id" Title="@L.Localize("MunsoftInstance_Id", "Id")" Width="90px" TextAlign="TextAlign.Center"
                              FilterLookupData="@_idLookupOptions" FilterLookupTextProperty="Text" FilterLookupValueProperty="Value" />
        <RadzenDataGridColumn TItem="MunsoftInstanceDto" Property="Name" Title="@L.Localize("MunsoftInstance_Name", "Name")"
                              FilterLookupData="@_nameLookupOptions" FilterLookupTextProperty="Text" FilterLookupValueProperty="Value" />
        <RadzenDataGridColumn TItem="MunsoftInstanceDto" Property="MunicipalityName" Title="@L.Localize("MunsoftInstance_MunicipalityName", "Municipality Name")"
                              FilterLookupData="@_municipalityLookupOptions" FilterLookupTextProperty="Text" FilterLookupValueProperty="Value" />
        <RadzenDataGridColumn TItem="MunsoftInstanceDto" Property="DemarcationCode" Title="@L.Localize("MunsoftInstance_DemarcationCode", "Demarcation Code")"
                              FilterLookupData="@_demarcationLookupOptions" FilterLookupTextProperty="Text" FilterLookupValueProperty="Value" />
    </Columns>
</AdvancedDataGrid>
