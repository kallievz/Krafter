@using AditiKraft.Krafter.UI.Web.Client.Common.Permissions
@attribute [Route(RoutePath)]
@attribute [MustHavePermission(PermissionAction.View, PermissionResource.Notifications)]

<PageTitle>Jobs Dashboard</PageTitle>

<RadzenStack Gap="0.75rem" class="rz-p-2">
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H1">TickerQ Jobs Dashboard</RadzenText>
    <RadzenText TextStyle="TextStyle.Body1">
        Monitor and inspect background job execution from the integrated dashboard.
    </RadzenText>
    <RadzenLink Path="@DashboardUrl" Text="Open dashboard in a new tab" Target="_blank" />
</RadzenStack>

<iframe src="@DashboardUrl"
        title="TickerQ Jobs Dashboard"
        style="width: 100%; height: calc(100vh - 220px); border: 1px solid var(--rz-base-300); border-radius: 8px;">
</iframe>
