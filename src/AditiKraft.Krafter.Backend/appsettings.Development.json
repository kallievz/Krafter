{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SMTPEmailSettings": {
    "Host": "{SMTP_HOST}",
    "Port": 587,
    "UserName": "{SMTP_USERNAME}",
    "Password": "{SMTP_PASSWORD}",
    "SenderEmail": "{SMTP_SENDER_EMAIL}",
    "SenderName": "{SMTP_SENDER_NAME}"
  },
  "Urls": {
    "RootUiUrl": "https://localhost:7291",
    "TenantBaseDomain": "",
    "ApiBaseUrl": "https://localhost:5199"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7291",
      "http://localhost:5116"
    ]
  },
  "Localization": {
    "Ollama": {
      "Enabled": true,
      "Endpoint": "http://localhost:11434",
      "Model": "llama3.1",
      "RequestTimeoutSeconds": 300
    }
  },
  "EfQueryPerformance": {
    "EnableCommandTiming": true,
    "SlowQueryThresholdMs": 100
  },
  "EndpointPerformance": {
    "EnableTiming": true,
    "SlowRequestThresholdMs": 250,
    "ApiOnly": true
  }
}
